# 配对密钥：客户端首次配对时携带，服务端 timingSafeEqual 比对（必填，缺失拒绝启动）
PAIRING_SECRET=change-me

# 监听端口（可选，默认 8790）
# PORT=8790

# 真实 PostgreSQL 连接串（可选；设置后走 node-postgres，优先于 PGLite）
# DATABASE_URL=postgres://user:pass@localhost:5432/app

# PGLite 落盘目录（可选；仅在未设 DATABASE_URL 时生效，不设则内存库、重启丢数据）
# PGLITE_DATA_DIR=./pglite-data
